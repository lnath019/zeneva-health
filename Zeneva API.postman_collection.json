          "name": "Get Reference Data (dev only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.sampleSlots && data.sampleSlots.length) {",
                  "    pm.collectionVariables.set('doctorSlotId', data.sampleSlots[0].id);",
                  "}",
                  "if (data.hospitals && data.hospitals.length) {",
                  "    pm.collectionVariables.set('hospitalId', data.hospitals[0].id);",
                  "}",
                  "if (data.specialisations && data.specialisations.length) {",
                  "    pm.collectionVariables.set('specialisationId', data.specialisations[0].id);",
                  "}",
                  "console.log('Reference IDs auto-saved from /dev/reference-data');"
